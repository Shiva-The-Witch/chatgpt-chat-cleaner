{
  "manifest_version": 3,
  "name": "ChatGPT Chat Cleaner & Organizer",
  "short_name": "Chat Cleaner",
  "version": "1.2.1",
  "description": "Organize, filter, export, and selectively remove ChatGPT conversations.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Chat Cleaner & Organizer",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "128": "icons/icon.png"
  }
}
